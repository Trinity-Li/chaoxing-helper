{
  "manifest_version": 3,
  "name": "视频防自动暂停（鼠标事件拦截器）",
  "version": "1.2.0",
  "description": "拦截 mouseout / mouseleave / pointerout / pointerleave 侦听器，让视频不会因为鼠标移出画面而自动暂停；点击、拖拽、滚轮、悬停照常可用。",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "视频防自动暂停：Alt+M 或点击图标切换",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
